# =============================================================================
# Evaion Echo — production environment reference
# =============================================================================
# THIS FILE IS NOT READ BY THE STATIC SITE.
#
# The delivered storefront is HTML + CSS only. It has no server, no JavaScript
# and no build step, so nothing here can change the rendered page. This file
# documents the variables a production commerce integration would require so
# the handover is explicit.
#
# Never commit real secrets. Never expose a secret key in HTML, CSS, client-side
# JavaScript or a public repository. Only publishable/client keys may reach the
# browser; secret keys belong on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Storefront state
# -----------------------------------------------------------------------------
# buy | preorder | waitlist
# Production should read this from the commerce backend and render the matching
# CTA, price, availability and structured data together.
SALES_MODE=buy

# Public origin, used for canonical URLs, OG tags and checkout return URLs.
SITE_URL=https://evaion.in

# -----------------------------------------------------------------------------
# Shopify Checkout (option A)
# -----------------------------------------------------------------------------
# Storefront API is the supported path for a custom front end. The Storefront
# access token is public by design but must still be scoped correctly.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-01
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=replace_with_public_storefront_token

# Server-only. Used for webhook verification and Admin API order operations.
SHOPIFY_ADMIN_API_TOKEN=replace_with_server_side_admin_token
SHOPIFY_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Product and variant identifiers for Echo / Violet Alloy.
SHOPIFY_PRODUCT_ID=replace_with_product_gid
SHOPIFY_VARIANT_ID=replace_with_variant_gid

# -----------------------------------------------------------------------------
# Razorpay (option B)
# -----------------------------------------------------------------------------
# Key ID is publishable. Key secret and webhook secret are server-only.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_server_side_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Test mode must be explicit. Never mix test and live credentials.
RAZORPAY_MODE=test

# -----------------------------------------------------------------------------
# Orders, tax and invoicing
# -----------------------------------------------------------------------------
# The storefront shows an indicative MRP only. Final pricing, GST treatment and
# invoice generation belong to the commerce backend.
CURRENCY=INR
PRICE_INCLUDES_TAX=true
GST_RATE=replace_with_confirmed_rate
INVOICE_PROVIDER=replace_with_invoice_provider
INVOICE_PROVIDER_KEY=replace_with_server_side_key

# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------
# Order confirmation, dispatch and support notifications.
MAIL_PROVIDER=replace_with_provider
MAIL_API_KEY=replace_with_server_side_key
MAIL_FROM=replace_with_verified_sender
MAIL_REPLY_TO=replace_with_monitored_reply_address

# -----------------------------------------------------------------------------
# Logistics and serviceability
# -----------------------------------------------------------------------------
# The pincode field on echo.html validates format only. Real serviceability
# checks require a server-side logistics integration.
LOGISTICS_PROVIDER=replace_with_provider
LOGISTICS_API_KEY=replace_with_server_side_key
LOGISTICS_PICKUP_PINCODE=replace_with_warehouse_pincode

# -----------------------------------------------------------------------------
# Support
# -----------------------------------------------------------------------------
# The support form is disabled in the static build.
SUPPORT_ENDPOINT=replace_with_ticketing_endpoint
SUPPORT_FROM_EMAIL=replace_with_verified_sender
SUPPORT_HOURS=replace_with_confirmed_hours

# -----------------------------------------------------------------------------
# Analytics and consent
# -----------------------------------------------------------------------------
# The static build sets no cookies and loads no analytics. If analytics is added,
# it must respect consent and the final privacy notice.
ANALYTICS_PROVIDER=none
ANALYTICS_ID=
CONSENT_REQUIRED=true

# -----------------------------------------------------------------------------
# Content and legal
# -----------------------------------------------------------------------------
# These values must not be invented in markup. Supply reviewed values.
LEGAL_ENTITY=replace_with_registered_entity
REGISTERED_ADDRESS=replace_with_registered_address
GSTIN=replace_with_gstin
GRIEVANCE_OFFICER=replace_with_name_and_contact
POLICY_LAST_UPDATED=replace_with_iso_date

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Keep this example file out of the public document root, or accept that it is
# readable documentation containing placeholders only.
NODE_ENV=production
